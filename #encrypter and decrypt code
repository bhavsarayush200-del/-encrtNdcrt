def encrypt() :
    message = input("Enter the message to encrypt: ")
    text = list(message)
    i = len(text)
    for i in range(i):
        if text[i] in code:
            text[i] = code[text[i]]
    emessage = ''.join(text)
    return emessage

def decrypt() :
    message = input("Enter the message to decrypt: ")
    text = list(message)
    i = len(text)
    for i in range(i):
        if text[i] in decode:
            text[i] = decode[text[i]]
    dmessage = ''.join(text)
    return dmessage

